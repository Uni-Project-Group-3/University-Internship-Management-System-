{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["studentId"]
    },
    "assignments": {
      ".indexOn": ["studentId", "academicSupervisorId"]
    },
    "placements": {
      ".indexOn": ["studentId", "studentProfileId", "companyId", "companySupervisorId", "supervisorId"]
    },
    "tasks": {
      ".indexOn": ["placementId"]
    },
    "taskExams": {
      ".indexOn": ["placementId", "companyId", "createdBy"]
    },
    "weeklyReports": {
      ".indexOn": ["companyId", "companySupervisorId", "academicSupervisorId", "studentId"]
    }
  }
}
