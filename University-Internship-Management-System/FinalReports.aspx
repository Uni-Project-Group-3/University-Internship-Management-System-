<%@ Page Language="C#" AutoEventWireup="true" CodePage="65001" %>
<%@ Register Src="~/Shared/CompanySidebar.ascx" TagPrefix="uims" TagName="CompanySidebar" %>
<%@ Register Src="~/Shared/AcademicSidebar.ascx" TagPrefix="uims" TagName="AcademicSidebar" %>
<%@ Register Src="~/Shared/CoordinatorSidebar.ascx" TagPrefix="uims" TagName="CoordinatorSidebar" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8"/><base href="<%= ResolveUrl("~/") %>" /><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Final training reports | JUST Internships</title><link href="Assets/shared/colors.css" rel="stylesheet"/><link href="Assets/final-reports.css?v=20261024-one-page" rel="stylesheet"/>    <link href="Assets/shared/workflow-ui.css?v=20261025-send-certificate" rel="stylesheet" />
<asp:PlaceHolder ID="CompanyWorkspaceStyles" runat="server" Visible="false"><link href="Assets/shared/workspace-identity.css?v=20261025-progress-stat" rel="stylesheet"/><link href="Assets/company/final-reports-shell.css?v=20261024-hero-layout" rel="stylesheet"/></asp:PlaceHolder>
</head>
<body id="pageBody" runat="server" class="coordinator-banner"><form runat="server"><div class="app-layout final-reports-layout">
<asp:PlaceHolder ID="CompanySidebarSlot" runat="server" Visible="false"><uims:CompanySidebar ID="companySidebar" runat="server" SidebarId="sidebar"/></asp:PlaceHolder><asp:PlaceHolder ID="AcademicSidebarSlot" runat="server" Visible="false"><uims:AcademicSidebar ID="academicSidebar" runat="server" SidebarId="sidebar"/></asp:PlaceHolder><asp:PlaceHolder ID="CoordinatorSidebarSlot" runat="server" Visible="false"><uims:CoordinatorSidebar ID="coordinatorSidebar" runat="server" SidebarId="sidebar"/></asp:PlaceHolder>
<div class="main final-reports-main"><asp:PlaceHolder ID="CompanyTopbarSlot" runat="server" Visible="false"><header class="topbar company-report-topbar"><div class="topbar-actions ms-auto"><span class="company-report-avatar" aria-hidden="true"><%= RoleInitials %></span><span class="company-report-user"><strong><%= RoleTitle %></strong><small>Internship workspace</small></span><a class="company-report-account" href="<%= RoleAccountUrl %>" aria-label="<%= RoleTitle %> account"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a></div></header></asp:PlaceHolder>
<main class="final-workspace"><header class="final-report-hero"><div class="final-report-hero-copy"><span class="final-report-hero-kicker">JUST / <%= RoleTitle.ToUpperInvariant() %> WORKSPACE</span><h1><%= RoleHeading %></h1><p><%= RoleIntro %></p></div></header><p id="finalNotice" role="status">Loading authorized records...</p><section id="finalSummary" aria-label="Training completion summary"></section><div class="report-tools"><label>Search student name or ID<input id="finalSearch" type="search"/></label><label>Status<select id="finalFilter"><option value="">All statuses</option><option value="draft">Draft</option><option value="pendingAcademicReview">Academic review</option><option value="companyRevisionRequested">Company revision requested</option><option value="pendingAdminReview">Admin review</option><option value="academicRevisionRequested">Academic corrections</option><option value="completed">Completed</option></select></label><button type="button" id="finalReload">Refresh records</button></div><section id="finalRecords" aria-live="polite"></section></main></div></div></form><script src="Js_project/firebase-client.js?v=20261024-final-tab-session"></script><script src="Js_project/final-reports.js?v=20261025-send-to-admin"></script><script src="Js_project/workspace-navigation-unified.js?v=20261025-notifications" defer></script><script runat="server">
protected string RoleTitle = "Company Supervisor", RoleInitials = "CS", RoleAccountUrl = "Company/CompanySupervisorAccount.aspx", RoleHeading = "Final reports &amp; approvals", RoleIntro = "Review authorized trainee reports and track final approval progress.";
protected void Page_Init(object sender, EventArgs e)
{
    var user = Context.User;
    bool signedIn = user != null && user.Identity != null && user.Identity.IsAuthenticated;
    bool company = signedIn && user.IsInRole("companySupervisor"), academic = signedIn && user.IsInRole("academicSupervisor"), coordinator = signedIn && user.IsInRole("coordinator");
    // Every supervising role works in this one report workflow, inside its own sidebar.
    CompanyWorkspaceStyles.Visible = company || academic || coordinator;
    CompanyTopbarSlot.Visible = company || academic || coordinator;
    CompanySidebarSlot.Visible = company; AcademicSidebarSlot.Visible = academic; CoordinatorSidebarSlot.Visible = coordinator;
    if (academic) { RoleTitle = "Academic Supervisor"; RoleInitials = "AS"; RoleAccountUrl = "Academic/AcademicSupervisorAccount.aspx"; RoleHeading = "Final Academic Evaluation"; RoleIntro = "Review final training reports submitted by companies for your students, then approve or return them."; }
    if (coordinator) { RoleTitle = "Internship Coordinator"; RoleInitials = "CO"; RoleAccountUrl = "Coordinator/CoordinatorAccountProfile.aspx"; RoleHeading = "Final Report Approvals"; RoleIntro = "Give the final decision on academically approved reports. Approval completes the training and emails the student a certificate."; }
    if (company || academic || coordinator) pageBody.Attributes["class"] = "coordinator-banner company-report-shell";
}
</script></body></html>
